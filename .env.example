# Copy to .env and fill in. Never commit real values.
# Read by app/config.py (via python-dotenv) and run.py.

# ---------------------------------------------------------------- core
# REQUIRED. The app refuses to start without it. Also keys the password-reset code hashes, so
# changing it invalidates any reset in progress. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLAlchemy URL. Defaults to a local SQLite file. "postgres://" URLs (Render/Heroku) are accepted.
DATABASE_URL=sqlite:///app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/tabital

# 1 = debug mode, and Swagger UI on. Keep 0 in production.
FLASK_DEBUG=0
# 1 = serve Swagger UI at /swagger-ui (lists admin endpoints). Defaults to FLASK_DEBUG.
ENABLE_API_DOCS=0

# Used by run.py
HOST=0.0.0.0
PORT=5000

# Public URL of the web app (payment links, QR codes)
FRONTEND_URL=http://localhost:4200
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:4200,https://app.tabitalpay.com

# X-Forwarded-For hops added by your own proxies (Render: 1). Use 0 if nothing is in front of the app.
TRUSTED_PROXY_COUNT=1

# ---------------------------------------------------------------- sessions
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ---------------------------------------------------------------- guessing limits (all optional)
LOGIN_MAX_FAILURES=5
LOGIN_MAX_ACCOUNTS_PER_IP=20
LOGIN_WINDOW_MINUTES=15
OTP_MAX_FAILURES_PER_DAY=10
OTP_MAX_ACCOUNTS_PER_IP=10
SIGNUP_MAX_FAILURES_PER_IP=10
RESET_REQUESTS_PER_IP_PER_HOUR=10
RESET_CODES_PER_ACCOUNT_PER_DAY=10

# ---------------------------------------------------------------- email (password reset codes)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
# Defaults to MAIL_USERNAME
MAIL_DEFAULT_SENDER=

# ---------------------------------------------------------------- SMS (reminders, SMS password reset)
# log (default: only writes to the server log, nothing is sent) | mnotify | hubtel
SMS_PROVIDER=log

# mNotify (SMS_PROVIDER=mnotify). The sender ID must be approved in mNotify.
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=TabitalPay
MNOTIFY_BASE_URL=https://api.mnotify.com/api

# Hubtel (SMS_PROVIDER=hubtel). The sender ID must be approved in Hubtel.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=TabitalPay
HUBTEL_BASE_URL=https://smsc.hubtel.com/v1

# ---------------------------------------------------------------- Paystack (use sk_test_/pk_test_ until go-live)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Frontend page Paystack sends the customer to after paying
PAYSTACK_CALLBACK_URL=http://localhost:4200/customer/payment-callback

# ---------------------------------------------------------------- Smile ID (identity checks; sandbox until go-live)
SMILEID_PARTNER_ID=
SMILEID_API_KEY=
SMILEID_BASE_URL=https://testapi.smileidentity.com
# Public https URL Smile ID posts results to
SMILEID_CALLBACK_URL=

# ---------------------------------------------------------------- legal documents
TERMS_URL=https://tabitalpay.com/elementor-page-3332/
# Bump whenever the Terms change; each order records it
TERMS_VERSION=2026-09-26
PRIVACY_POLICY_URL=https://tabitalpay.com/privacy-policy/

# ---------------------------------------------------------------- merchant payment gateway
# Minutes a hosted checkout link stays valid
GATEWAY_SESSION_MINUTES=30
GATEWAY_POS_SESSION_MINUTES=15
GATEWAY_WEBHOOK_TIMEOUT=5
# Local development only: allow http:// and private addresses for storefront/webhook URLs
GATEWAY_ALLOW_INSECURE_URLS=0
